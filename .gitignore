# Secrets - NEVER commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / front-end build output (sources are committed, build output is not)
node_modules/
ui/web/dist/
*.tsbuildinfo

# App runtime data (portable mode)
data/
logs/
*.db
*.db-wal
*.db-shm

# Verification artifacts (screenshots/reports produced by the harness)
artifacts/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/

# Tooling state (Command Code session/taste data - not part of the product)
.commandcode/
